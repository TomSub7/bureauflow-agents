# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# BureauFlow database (Neon PostgreSQL)
DATABASE_URL=postgresql://...

# Resend email API key
RESEND_API_KEY=re_...

# Vapi voice API
VAPI_API_KEY=your-vapi-key

# Optional: override model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# ─── External MCP Server Connectors ─────────────────────────────────
# These enable agents to access real external services via MCP.
# Only configure the ones you need — agents skip unconfigured connectors.

# Gmail MCP (for email-agent-live)
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_IMAP_USER=tomasmarty@bureauflow.io
GMAIL_IMAP_APP_PASSWORD=your-gmail-app-password

# Google Calendar MCP (for support-agent appointment booking)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Stripe MCP (for lead-agent payment status checks)
# Get your key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Composio MCP (unified gateway for 500+ apps — optional fallback)
# Get these from https://app.composio.dev/settings
COMPOSIO_MCP_URL=https://backend.composio.dev/tool_router/your-id/mcp
COMPOSIO_API_KEY=ak_...

# ─── Claude Code MCP servers (.mcp.json) ────────────────────────────
# Project-scoped MCP servers for the Claude Code CLI itself (see .mcp.json).
# Keys are referenced from the environment via ${VAR} expansion — never
# commit real values.
#
# NOTE: the browser-control servers (playwright, chrome-devtools) were removed
# from .mcp.json on purpose — they can drive your real, logged-in local browser
# session, which is broad local access. Re-add them only if you explicitly want
# that, and understand the implication. The three below are network API calls
# only (no local filesystem or browser access).

# Perplexity MCP — real-time web search (https://www.perplexity.ai/account/api)
PERPLEXITY_API_KEY=pplx-...

# Firecrawl MCP — crawl/scrape sites into the chat (https://www.firecrawl.dev/app/api-keys)
FIRECRAWL_API_KEY=fc-...

# glif MCP — image/video generation workflows (https://glif.app/settings/api-tokens)
GLIF_API_TOKEN=your-glif-token

